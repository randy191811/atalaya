[Unit]
Description=Atalaya (tienda de PoE2 vigilada + tasador con IA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atalaya
Group=atalaya
WorkingDirectory=/opt/atalaya
EnvironmentFile=/etc/atalaya.env
Environment=DATA_DIR=/var/lib/atalaya
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server/index.js
Restart=on-failure
RestartSec=5

# Endurecimiento: el servicio solo puede escribir en su carpeta de datos
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atalaya
StateDirectory=atalaya
StateDirectoryMode=0700
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
