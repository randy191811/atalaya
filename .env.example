# Copia este archivo como /etc/atalaya.env en tu servidor (permisos 600) y rellena lo tuyo.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# La dirección pública exacta de tu página, con https y sin barra final.
PUBLIC_ORIGIN=https://TU-DOMINIO

# Correo de contacto: se envía al mercado oficial en cada consulta (lo piden por educación) y es el de soporte.
MARKET_CONTACT=tu-correo@ejemplo.com

# Liga por defecto al crear una tienda (cámbiala cuando empiece una liga nueva).
DEFAULT_LEAGUE=Standard

# Quién puede registrarse: open (cualquiera) o invite (solo con invitación desde Administrar).
SIGNUP_MODE=open
MAX_USERS=1000

# Cuenta de administración (opcional). Si lo dejas vacío, el PRIMER registro será el administrador.
# ADMIN_NAME=Tu nombre
# ADMIN_EMAIL=tu-correo@ejemplo.com
# ADMIN_PASSWORD=una-clave-larga-de-verdad

# Claves de la IA: lo normal es pegarlas desde la página (Administrar → Clave de la IA), que las
# comprueba y las guarda cifradas. Solo si prefieres variables de entorno, descomenta:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Precio: sin poner (o free) = gratis para todos. mock = planes Pro/Mercader con cobro SIMULADO.
# BILLING_MODE=free
# Límites de cada cuenta mientras es gratis:
FREE_SHOPS=1
FREE_INTERVAL_MIN=10
FREE_CREDITS=30
FREE_WISHES=25

# Topes de la IA para proteger tu bolsillo: por usuario y minuto, y para toda la página al día.
AI_PER_USER_MIN=6
AI_GLOBAL_DAY=1500
